FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends conntrack ipset iptables \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY app/__init__.py \
     app/collector.py \
     app/collector_main.py \
     app/config.py \
     app/database.py \
     app/firewall.py \
     app/tailscale.py \
     app/website_collector.py \
     ./app/

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-m", "app.collector_main", "--healthcheck"]

CMD ["python", "-m", "app.collector_main"]
